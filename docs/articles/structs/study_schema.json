{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "StudyID": {
      "type": "object",
      "properties": {
        "data": { "type": ["null", "string"] },
        "label": { "type": "string", "const": "Study ID" },
        "type": { "type": "string", "const": "text" },
        "required": { "type": "boolean", "const": true }
      },
      "required": ["data", "label", "type", "required"]
    },
    "StudyType": {
      "type": "object",
      "properties": {
        "data": { "type": "array", "items": { "type": "string" } },
        "label": { "type": "string", "const": "Study Type" },
        "type": { "type": "string", "const": "list" },
        "required": { "type": "boolean", "const": true }
      },
      "required": ["data", "label", "type", "required"]
    },
    "CountryPublication": {
      "type": "object",
      "properties": {
        "data": { "type": "array", "items": { "type": "string" } },
        "label": { "type": "string", "const": "Country Of Publication" },
        "type": { "type": "string", "const": "list" },
        "required": { "type": "boolean", "const": false }
      },
      "required": ["data", "label", "type", "required"]
    },
    "DurationSurvey": {
      "type": "object",
      "properties": {
        "data": { "type": ["null", "number"] },
        "label": { "type": "string", "const": "Duration of Survey" },
        "type": { "type": "string", "const": "number" },
        "required": { "type": "boolean", "const": true }
      },
      "required": ["data", "label", "type", "required"]
    },
    "Year": {
      "type": "object",
      "properties": {
        "data": { "type": ["null", "number"] },
        "label": { "type": "string", "const": "Year" },
        "type": { "type": "string", "const": "number" },
        "required": { "type": "boolean", "const": true }
      },
      "required": ["data", "label", "type", "required"]
    },
    "Bib.AUTHOR": {
      "type": "object",
      "properties": {
        "data": { "type": ["null", "string"] },
        "label": { "type": "string", "const": "Author(s)" },
        "type": { "type": "string", "const": "text" },
        "required": { "type": "boolean", "const": true }
      },
      "required": ["data", "label", "type", "required"]
    },
    "Bib.TITLE": {
      "type": "object",
      "properties": {
        "data": { "type": ["null", "string"] },
        "label": { "type": "string", "const": "Title" },
        "type": { "type": "string", "const": "text" },
        "required": { "type": "boolean", "const": true }
      },
      "required": ["data", "label", "type", "required"]
    },
    "Bib.JOURNAL": {
      "type": "object",
      "properties": {
        "data": { "type": ["null", "string"] },
        "label": { "type": "string", "const": "Journal" },
        "type": { "type": "string", "const": "text" },
        "required": { "type": "boolean", "const": false }
      },
      "required": ["data", "label", "type", "required"]
    },
    "Bib.VOLUME": {
      "type": "object",
      "properties": {
        "data": { "type": ["null", "number"] },
        "label": { "type": "string", "const": "Volume" },
        "type": { "type": "string", "const": "number" },
        "required": { "type": "boolean", "const": false }
      },
      "required": ["data", "label", "type", "required"]
    },
    "Bib.PAGES": {
      "type": "object",
      "properties": {
        "data": { "type": ["null", "number"] },
        "label": { "type": "string", "const": "Pages" },
        "type": { "type": "string", "const": "number" },
        "required": { "type": "boolean", "const": false }
      },
      "required": ["data", "label", "type", "required"]
    },
    "Bib.DOI": {
      "type": "object",
      "properties": {
        "data": { "type": ["null", "string"] },
        "label": { "type": "string", "const": "DOI" },
        "type": { "type": "string", "const": "text" },
        "required": { "type": "boolean", "const": true }
      },
      "required": ["data", "label", "type", "required"]
    },
    "Bib.URL": {
      "type": "object",
      "properties": {
        "data": { "type": ["null", "string"] },
        "label": { "type": "string", "const": "URL" },
        "type": { "type": "string", "const": "text" },
        "required": { "type": "boolean", "const": false }
      },
      "required": ["data", "label", "type", "required"]
    }
  },
  "required": [
    "StudyID",
    "StudyType",
    "CountryPublication",
    "DurationSurvey",
    "Year",
    "Bib.AUTHOR",
    "Bib.TITLE",
    "Bib.DOI"
  ]
}

